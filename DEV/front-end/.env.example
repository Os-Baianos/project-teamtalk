# Copie para .env.local e preencha com os valores do projeto Supabase (Project Settings > API).
# A chave "publishable" é pública por desenho, mas mesmo assim não vai para o Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave exclusiva do servidor, usada em rotas protegidas e tarefas internas. Nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel: uploads de 10 MiB requerem Fluid Compute, 4 GB de memória e
# VERCEL_SUPPORT_LARGE_REQUEST_BODY=1 no ambiente de Preview/Production.
